# Copy to .env.local for local development, and add the same two values in Vercel.
# Leave them empty to run the app in demo mode with the sample company.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The address the app runs at, used for login links. Vercel sets VERCEL_URL itself.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
